{
  "name": "prime-numbers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:wasm": "emcc wasm/sieve.c -O3 --no-entry -sSTANDALONE_WASM -sALLOW_MEMORY_GROWTH -sEXPORTED_FUNCTIONS=_sieve_next,_sieve_prev,_output_buffer -o public/sieve.wasm",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node --test 'lib/**/*.test.ts'",
    "test:native": "mkdir -p .cache && cc -O2 -std=c11 -Wall -Wextra -o .cache/sieve_test tests/native/sieve_test.c wasm/sieve.c -lm && .cache/sieve_test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sass": "^1.105.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
